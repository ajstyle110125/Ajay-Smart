//@version=6
indicator("Ajay Trade Engine - 1M/5M Precision v13", shorttitle="ATE P13", overlay=true, max_labels_count=100, max_lines_count=100)

//==================================================
// ATE PRECISION v13
// FIXED:
// 1M + 5M only
// SCALP hard minimum = 100
// No signal when 100 target room is unavailable
// MASTER BUY / MASTER SELL for large moves
// Only ONE CONTINUE marker per active direction
// Simpler filters so signals do not disappear for 30-60 minutes
//==================================================

//------------------------------
// TIMEFRAME
//------------------------------
bool tf1m = timeframe.isminutes and timeframe.multiplier == 1
bool tf5m = timeframe.isminutes and timeframe.multiplier == 5
bool tradeTF = tf1m or tf5m
string biasTF = tf1m ? "5" : "15"

//------------------------------
// INPUTS
//------------------------------
string G1 = "ENTRY"
string G2 = "MASTER"
string G3 = "TARGET"
string G4 = "DISPLAY"

int srLen = input.int(20, "Structure Lookback", minval=8, maxval=60, group=G1)
int zoneLen = input.int(5, "Reaction Lookback", minval=2, maxval=12, group=G1)
float zoneATR = input.float(0.25, "S/R Reaction Zone ATR", minval=0.05, maxval=0.80, step=0.05, group=G1)
int cooldown1m = input.int(3, "1M Signal Cooldown", minval=1, maxval=20, group=G1)
int cooldown5m = input.int(1, "5M Signal Cooldown", minval=1, maxval=10, group=G1)

float masterBodyATR = input.float(0.85, "MASTER Body / ATR", minval=0.60, maxval=1.50, step=0.05, group=G2)
float masterMinRoom = input.float(200.0, "MASTER Minimum Room", minval=100.0, step=50.0, group=G2)
float masterWick = input.float(0.35, "MASTER Opposite Wick Limit", minval=0.10, maxval=0.50, step=0.05, group=G2)
int masterCooldown = input.int(5, "MASTER Cooldown", minval=1, maxval=30, group=G2)

float scalpMinCrypto = input.float(100.0, "SCALP MIN - Crypto Price Units", minval=100.0, step=10.0, group=G3)
int scalpMinTicks = input.int(100, "SCALP MIN - FX/XAU Ticks", minval=100, step=10, group=G3)
int tpCount = input.int(8, "TP Levels", minval=3, maxval=12, group=G3)

bool showScalp = input.bool(true, "Show SCALP", group=G4)
bool showMaster = input.bool(true, "Show MASTER", group=G4)
bool showContinue = input.bool(true, "Show CONTINUE", group=G4)
bool showEnd = input.bool(true, "Show MASTER END", group=G4)
bool showTP = input.bool(true, "Show TP Lines", group=G4)
bool showDashboard = input.bool(true, "Show Dashboard", group=G4)

//------------------------------
// CORE
//------------------------------
float atr = ta.atr(14)
float atrAvg = ta.sma(atr, 20)
float rng = math.max(high - low, syminfo.mintick)
float body = math.abs(close - open)
float bodyPct = body / rng
float closeLoc = (close - low) / rng
float upperWick = high - math.max(open, close)
float lowerWick = math.min(open, close) - low

bool nonCrypto = syminfo.type == "forex" or str.contains(str.upper(syminfo.ticker), "XAU")
float scalpStep = nonCrypto ? syminfo.mintick * scalpMinTicks : scalpMinCrypto

//------------------------------
// STRUCTURE
//------------------------------
float support = ta.lowest(low, srLen)[1]
float resistance = ta.highest(high, srLen)[1]
float reactionLow = ta.lowest(low, zoneLen)[1]
float reactionHigh = ta.highest(high, zoneLen)[1]

float zone = atr * zoneATR

bool nearSupport = low <= support + zone and close >= support
bool nearResistance = high >= resistance - zone and close <= resistance

bool bullReaction = nearSupport and close > open and closeLoc >= 0.55 and lowerWick >= body * 0.15
bool bearReaction = nearResistance and close < open and closeLoc <= 0.45 and upperWick >= body * 0.15

bool bullImpulse = close > open and body >= atr * 0.65 and bodyPct >= 0.50 and closeLoc >= 0.62
bool bearImpulse = close < open and body >= atr * 0.65 and bodyPct >= 0.50 and closeLoc <= 0.38

bool bullBreak = close > resistance and close[1] <= resistance
bool bearBreak = close < support and close[1] >= support

// After a large candle, allow the first orderly continuation candle.
bool bullContinuationCandle = close > open and close > close[1] and low <= high[1] and closeLoc >= 0.55
bool bearContinuationCandle = close < open and close < close[1] and high >= low[1] and closeLoc <= 0.45

//------------------------------
// HIGHER TIMEFRAME BIAS
//------------------------------
float htfFast = request.security(syminfo.tickerid, biasTF, ta.ema(close, 20), lookahead=barmerge.lookahead_off)
float htfSlow = request.security(syminfo.tickerid, biasTF, ta.ema(close, 50), lookahead=barmerge.lookahead_off)
bool htfBull = htfFast > htfSlow
bool htfBear = htfFast < htfSlow

float localFast = ta.ema(close, 9)
float localSlow = ta.ema(close, 21)
bool localBull = localFast > localSlow
bool localBear = localFast < localSlow

//------------------------------
// TARGET ROOM
//------------------------------
// For a normal support/resistance setup, the opposite wall must leave >= 100.
// For a breakout/trend setup, there may be no wall above/below price; in that case
// the hard 100 target itself is used as the minimum available room.
float buyWallRoom = resistance > close ? resistance - close : na
float sellWallRoom = support < close ? close - support : na

bool buyHardRoom = tradeTF and (
     (not na(buyWallRoom) and buyWallRoom >= scalpStep) or
     (bullBreak and na(buyWallRoom)) or
     (bullImpulse and localBull and (na(buyWallRoom) or buyWallRoom >= scalpStep))
     )

bool sellHardRoom = tradeTF and (
     (not na(sellWallRoom) and sellWallRoom >= scalpStep) or
     (bearBreak and na(sellWallRoom)) or
     (bearImpulse and localBear and (na(sellWallRoom) or sellWallRoom >= scalpStep))
     )

//------------------------------
// LIGHT RISK FILTER
//------------------------------
// Avoid very poor entries, but do not make the engine so restrictive that
// valid 100-target setups disappear.
float buyAnchor = bullReaction ? support : reactionLow
float sellAnchor = bearReaction ? resistance : reactionHigh
float buyRisk = close - (buyAnchor - atr * 0.20)
float sellRisk = (sellAnchor + atr * 0.20) - close

bool buyRiskOK = buyRisk > 0 and scalpStep / buyRisk >= 1.05
bool sellRiskOK = sellRisk > 0 and scalpStep / sellRisk >= 1.05

//------------------------------
// SCALP ENGINE
//------------------------------
bool buyLocation = bullReaction or bullBreak or (bullImpulse and localBull) or (bullContinuationCandle and localBull)
bool sellLocation = bearReaction or bearBreak or (bearImpulse and localBear) or (bearContinuationCandle and localBear)

bool buyDirection = htfBull or localBull or bullReaction or bullBreak
bool sellDirection = htfBear or localBear or bearReaction or bearBreak

bool scalpBuySetup = tradeTF and buyHardRoom and buyRiskOK and buyLocation and buyDirection
bool scalpSellSetup = tradeTF and sellHardRoom and sellRiskOK and sellLocation and sellDirection

//------------------------------
// MASTER ENGINE
//------------------------------
bool masterBullCandle = bullImpulse and body >= atr * masterBodyATR and closeLoc >= 0.68 and upperWick <= rng * masterWick and atr >= atrAvg * 0.85
bool masterBearCandle = bearImpulse and body >= atr * masterBodyATR and closeLoc <= 0.32 and lowerWick <= rng * masterWick and atr >= atrAvg * 0.85

bool masterBuyStructure = bullBreak or bullReaction or (masterBullCandle and localBull)
bool masterSellStructure = bearBreak or bearReaction or (masterBearCandle and localBear)

bool masterBuyRoom = tradeTF and (
     (not na(buyWallRoom) and buyWallRoom >= masterMinRoom) or
     (bullBreak and na(buyWallRoom)) or
     (masterBullCandle and localBull and na(buyWallRoom))
     )

bool masterSellRoom = tradeTF and (
     (not na(sellWallRoom) and sellWallRoom >= masterMinRoom) or
     (bearBreak and na(sellWallRoom)) or
     (masterBearCandle and localBear and na(sellWallRoom))
     )

bool masterBuyDirection = htfBull or localBull or bullBreak or bullReaction
bool masterSellDirection = htfBear or localBear or bearBreak or bearReaction

bool masterBuySetup = masterBuyRoom and masterBuyStructure and masterBullCandle and masterBuyDirection
bool masterSellSetup = masterSellRoom and masterSellStructure and masterBearCandle and masterSellDirection

// One trigger per setup, plus cooldown.
var int lastMasterBuyBar = na
var int lastMasterSellBar = na
bool masterBuyTrigger = masterBuySetup and not masterBuySetup[1] and (na(lastMasterBuyBar) or bar_index - lastMasterBuyBar >= masterCooldown)
bool masterSellTrigger = masterSellSetup and not masterSellSetup[1] and (na(lastMasterSellBar) or bar_index - lastMasterSellBar >= masterCooldown)

if masterBuyTrigger
    lastMasterBuyBar := bar_index
if masterSellTrigger
    lastMasterSellBar := bar_index

//------------------------------
// MASTER STATE + REVERSAL
//------------------------------
var int masterState = 0
var float masterEntry = na

bool masterBuyEnd = masterState == 1 and bearImpulse and closeLoc <= 0.30 and (bearBreak or bearReaction)
bool masterSellEnd = masterState == -1 and bullImpulse and closeLoc >= 0.70 and (bullBreak or bullReaction)

if masterBuyTrigger
    masterState := 1
    masterEntry := close
else if masterSellTrigger
    masterState := -1
    masterEntry := close
else if masterBuyEnd or masterSellEnd
    masterState := 0
    masterEntry := na

//------------------------------
// FINAL SIGNALS
//------------------------------
var int lastBuyBar = na
var int lastSellBar = na

int cooldown = tf1m ? cooldown1m : cooldown5m
bool buyOK = na(lastBuyBar) or bar_index - lastBuyBar >= cooldown
bool sellOK = na(lastSellBar) or bar_index - lastSellBar >= cooldown

// MASTER has priority. While MASTER is active, don't spam same-direction scalp entries.
bool finalBuy = tradeTF and buyOK and not masterSellTrigger and (
     masterBuyTrigger or (scalpBuySetup and masterState != -1)
     )

bool finalSell = tradeTF and sellOK and not masterBuyTrigger and (
     masterSellTrigger or (scalpSellSetup and masterState != 1)
     )

if finalBuy
    lastBuyBar := bar_index
if finalSell
    lastSellBar := bar_index

//------------------------------
// TP ENGINE
//------------------------------
var line[] tpLines = array.new_line()
var label[] tpLabels = array.new_label()

f_clearTP() =>
    if array.size(tpLines) > 0
        for i = 0 to array.size(tpLines) - 1
            line.delete(array.get(tpLines, i))
        array.clear(tpLines)
    if array.size(tpLabels) > 0
        for i = 0 to array.size(tpLabels) - 1
            label.delete(array.get(tpLabels, i))
        array.clear(tpLabels)

f_drawTP(_entry, _buy) =>
    f_clearTP()
    if showTP
        for n = 1 to tpCount
            float target = _buy ? _entry + scalpStep * n : _entry - scalpStep * n
            line ln = line.new(bar_index, target, bar_index + 1, target, xloc=xloc.bar_index, extend=extend.right, color=_buy ? color.new(color.lime, 55) : color.new(color.red, 55), style=line.style_dashed, width=1)
            array.push(tpLines, ln)
            if n <= 2
                label lb = label.new(bar_index, target, "TP" + str.tostring(n) + "  " + str.tostring(target, format.mintick), yloc=yloc.price, style=label.style_label_left, color=_buy ? color.new(color.lime, 10) : color.new(color.red, 10), textcolor=_buy ? color.black : color.white, size=size.tiny)
                array.push(tpLabels, lb)

if finalBuy
    f_drawTP(close, true)
else if finalSell
    f_drawTP(close, false)

//------------------------------
// ONE CONTINUE MARKER ONLY
//------------------------------
var int activeDir = 0
var float activeEntry = na
var bool continueShown = false

if finalBuy
    if activeDir != 1
        activeDir := 1
        activeEntry := close
        continueShown := false
else if finalSell
    if activeDir != -1
        activeDir := -1
        activeEntry := close
        continueShown := false

bool buyContinue = activeDir == 1 and not continueShown and not na(activeEntry) and bar_index > nz(lastBuyBar, bar_index) and high >= activeEntry + scalpStep and close >= activeEntry
bool sellContinue = activeDir == -1 and not continueShown and not na(activeEntry) and bar_index > nz(lastSellBar, bar_index) and low <= activeEntry - scalpStep and close <= activeEntry

if buyContinue
    if showContinue
        label.new(bar_index, high, "BUY CONTINUE\n+" + str.tostring(scalpStep, format.mintick), yloc=yloc.price, style=label.style_label_down, color=color.lime, textcolor=color.black, size=size.tiny)
    continueShown := true

if sellContinue
    if showContinue
        label.new(bar_index, low, "SELL CONTINUE\n-" + str.tostring(scalpStep, format.mintick), yloc=yloc.price, style=label.style_label_up, color=color.red, textcolor=color.white, size=size.tiny)
    continueShown := true

if masterBuyEnd or masterSellEnd
    activeDir := 0
    activeEntry := na
    continueShown := false

//------------------------------
// VISIBLE SIGNALS
//------------------------------
if showMaster and masterBuyTrigger
    label.new(bar_index, low - atr * 0.20, "MASTER BUY\nHOLD MOVE", yloc=yloc.price, style=label.style_label_up, color=color.lime, textcolor=color.black, size=size.normal)
else if showScalp and finalBuy
    label.new(bar_index, low, "SCALP BUY\nMIN +" + str.tostring(scalpStep, format.mintick), yloc=yloc.price, style=label.style_label_up, color=color.lime, textcolor=color.black, size=size.small)

if showMaster and masterSellTrigger
    label.new(bar_index, high + atr * 0.20, "MASTER SELL\nHOLD MOVE", yloc=yloc.price, style=label.style_label_down, color=color.red, textcolor=color.white, size=size.normal)
else if showScalp and finalSell
    label.new(bar_index, high, "SCALP SELL\nMIN -" + str.tostring(scalpStep, format.mintick), yloc=yloc.price, style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)

if showEnd and masterBuyEnd
    label.new(bar_index, high + atr * 0.20, "MASTER BUY END\nPROTECT PROFIT", yloc=yloc.price, style=label.style_label_down, color=color.orange, textcolor=color.black, size=size.small)

if showEnd and masterSellEnd
    label.new(bar_index, low - atr * 0.20, "MASTER SELL END\nPROTECT PROFIT", yloc=yloc.price, style=label.style_label_up, color=color.orange, textcolor=color.black, size=size.small)

//------------------------------
// DASHBOARD
//------------------------------
var table dash = table.new(position.top_right, 2, 8, border_width=1)

if barstate.islast
    table.cell(dash, 0, 0, "ATE PRECISION v13")
    table.cell(dash, 1, 0, tradeTF ? (tf1m ? "1M" : "5M") : "OFF")
    table.cell(dash, 0, 1, "SCALP MIN")
    table.cell(dash, 1, 1, tradeTF ? str.tostring(scalpStep, format.mintick) : "100")
    table.cell(dash, 0, 2, "MASTER")
    table.cell(dash, 1, 2, masterState == 1 ? "BUY HOLD" : masterState == -1 ? "SELL HOLD" : "WAIT")
    table.cell(dash, 0, 3, "BUY ROOM")
    table.cell(dash, 1, 3, not na(buyWallRoom) ? str.tostring(buyWallRoom, format.mintick) : "OPEN")
    table.cell(dash, 0, 4, "SELL ROOM")
    table.cell(dash, 1, 4, not na(sellWallRoom) ? str.tostring(sellWallRoom, format.mintick) : "OPEN")
    table.cell(dash, 0, 5, "HTF")
    table.cell(dash, 1, 5, htfBull ? "BULL" : htfBear ? "BEAR" : "NEUTRAL")
    table.cell(dash, 0, 6, "LOCAL")
    table.cell(dash, 1, 6, localBull ? "BULL" : localBear ? "BEAR" : "NEUTRAL")
    table.cell(dash, 0, 7, "RULE")
    table.cell(dash, 1, 7, "100 MIN / 1M+5M")

//------------------------------
// ALERTS
//------------------------------
alertcondition(finalBuy, title="ATE BUY", message="ATE BUY: 100-minimum target room available")
alertcondition(finalSell, title="ATE SELL", message="ATE SELL: 100-minimum target room available")
alertcondition(masterBuyTrigger, title="ATE MASTER BUY", message="ATE MASTER BUY: larger move - HOLD MOVE")
alertcondition(masterSellTrigger, title="ATE MASTER SELL", message="ATE MASTER SELL: larger move - HOLD MOVE")
alertcondition(buyContinue, title="ATE BUY CONTINUE", message="ATE BUY CONTINUE: first 100 target reached")
alertcondition(sellContinue, title="ATE SELL CONTINUE", message="ATE SELL CONTINUE: first 100 target reached")
alertcondition(masterBuyEnd, title="ATE MASTER BUY END", message="ATE MASTER BUY END: protect profit")
alertcondition(masterSellEnd, title="ATE MASTER SELL END", message="ATE MASTER SELL END: protect profit")
