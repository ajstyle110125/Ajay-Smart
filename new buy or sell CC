//@version=6
indicator(
     "Ajay Trade Engine",
     shorttitle = "ATE",
     overlay = true,
     max_labels_count = 500,
     max_lines_count = 500,
     max_boxes_count = 500)

//==================================================
// BUILD-01 : CORE ENGINE
//==================================================

// Version
const string VERSION = "ATE v1.0"

// Colors
color BUY_COLOR  = color.lime
color SELL_COLOR = color.red

// Trade State
var int tradeState = 0

// Entry
var float entryPrice = na

// Dummy Plot (Remove Later)

//==================================================
// BUILD-02 : INPUT ENGINE
//==================================================

// Signal
showBuySell   = input(true,  "Show Buy / Sell")
showTargets   = input(true,  "Show Targets")
showDashboard = input(true,  "Show Dashboard")

// Trend
fastLength  = input(20,  "Fast EMA")
slowLength  = input(50,  "Slow EMA")
trendLength = input(200, "Trend EMA")

// Risk
riskReward    = input.float(3.0, "Risk Reward", step=0.5)
atrMultiplier = input.float(1.5, "ATR Multiplier", step=0.1)

// Filters
useSidewayFilter   = input(true, "Use Sideway Filter")
useVolumeFilter    = input(true, "Use Volume Filter")
useSmartMoney      = input(true, "Use Smart Money Filter")

// Alerts
enableAlerts = input(true, "Enable Alerts")

//==================================================
// BUILD-03 : TREND ENGINE
//==================================================

//------------------------------
// EMA ENGINE
//------------------------------

fastEMA  = ta.ema(close, fastLength)
slowEMA  = ta.ema(close, slowLength)
trendEMA = ta.ema(close, trendLength)

//------------------------------
// ATR ENGINE
//------------------------------

atr = ta.atr(14)

//------------------------------
// TREND DIRECTION
//------------------------------

trendBull = fastEMA > slowEMA and slowEMA > trendEMA
trendBear = fastEMA < slowEMA and slowEMA < trendEMA

//------------------------------
// TREND STRENGTH
//------------------------------

trendPower = math.abs(fastEMA - slowEMA)

strongTrend = trendPower > atr * 0.35

//------------------------------
// SIDEWAYS FILTER
//------------------------------

emaCompression = trendPower < atr * 0.20

sidewaysMarket =
     emaCompression and
     atr < ta.sma(atr, 20)

//------------------------------
// ALLOW SIGNALS
//------------------------------

allowBuy =
     trendBull and
     strongTrend and
     not sidewaysMarket

allowSell =
     trendBear and
     strongTrend and
     not sidewaysMarket

// Dummy plot (hidden)
//==================================================
// BUILD-04 : MARKET STRUCTURE ENGINE
//==================================================

//------------------------------
// SWING STRUCTURE
//------------------------------

swingHigh = ta.pivothigh(high, 3, 3)
swingLow  = ta.pivotlow(low, 3, 3)

//------------------------------
// LAST SWINGS
//------------------------------

var float lastSwingHigh = na
var float lastSwingLow  = na

if not na(swingHigh)
    lastSwingHigh := swingHigh

if not na(swingLow)
    lastSwingLow := swingLow

//------------------------------
// BREAK OF STRUCTURE (BOS)
//------------------------------

bullBOS =
     not na(lastSwingHigh) and
     close > lastSwingHigh

bearBOS =
     not na(lastSwingLow) and
     close < lastSwingLow

//------------------------------
// MARKET STRUCTURE
//------------------------------

bullishStructure =
     trendBull and
     bullBOS

bearishStructure =
     trendBear and
     bearBOS

//------------------------------
// CHANGE OF CHARACTER (CHOCH)
//------------------------------

bullCHOCH =
     trendBear and
     bullBOS

bearCHOCH =
     trendBull and
     bearBOS

//------------------------------
// MARKET PHASE
//------------------------------

trendingMarket =
     bullishStructure or
     bearishStructure

// Hidden Plot
//==================================================
// BUILD-05 : INSTITUTIONAL LIQUIDITY ENGINE
//==================================================

//------------------------------
// SWEEP LOOKBACK 
//------------------------------

liquidityLookback = 10

highestLiquidity = ta.highest(high, liquidityLookback)
lowestLiquidity  = ta.lowest(low, liquidityLookback)

//------------------------------
// BUY SIDE LIQUIDITY SWEEP
//------------------------------

buySideSweep =
     high > highestLiquidity[1] and
     close < highestLiquidity[1]

//------------------------------
// SELL SIDE LIQUIDITY SWEEP
//------------------------------

sellSideSweep =
     low < lowestLiquidity[1] and
     close > lowestLiquidity[1]

//------------------------------
// LIQUIDITY CONFIRMATION
//------------------------------

bullLiquidity =
     sellSideSweep and
     trendBull

bearLiquidity =
     buySideSweep and
     trendBear

//------------------------------
// FAKE BREAKOUT
//------------------------------

fakeBullBreakout =
     buySideSweep and
     not bullBOS

fakeBearBreakout =
     sellSideSweep and
     not bearBOS

//------------------------------
// INSTITUTIONAL SETUP
//------------------------------

institutionalBull =
     bullLiquidity and
     bullishStructure

institutionalBear =
     bearLiquidity and
     bearishStructure

// Hidden Plot
//==================================================
// BUILD-06 : SMART MONEY ENGINE
//==================================================

//------------------------------
// ORDER BLOCK
//------------------------------

bullOrderBlock =
     close[1] < open[1] and
     close > high[1]

bearOrderBlock =
     close[1] > open[1] and
     close < low[1]

//------------------------------
// FAIR VALUE GAP
//------------------------------

bullFVG =
     low > high[2]

bearFVG =
     high < low[2]

//------------------------------
// SMART MONEY SCORE
//------------------------------

smartBullScore = 0

smartBullScore += institutionalBull ? 30 : 0
smartBullScore += bullOrderBlock ? 25 : 0
smartBullScore += bullFVG ? 20 : 0
smartBullScore += bullBOS ? 25 : 0

smartBearScore = 0

smartBearScore += institutionalBear ? 30 : 0
smartBearScore += bearOrderBlock ? 25 : 0
smartBearScore += bearFVG ? 20 : 0
smartBearScore += bearBOS ? 25 : 0

//------------------------------
// SMART MONEY CONFIRMATION
//------------------------------

smartMoneyBull =
     smartBullScore >= 50

smartMoneyBear =
     smartBearScore >= 50

// Hidden Plot
//==================================================
// BUILD-07 : VOLUME + MOMENTUM ENGINE
//==================================================

//------------------------------
// VOLUME ENGINE
//------------------------------

avgVolume = ta.sma(volume, 20)

highVolume =
     volume > avgVolume * 1.20

ultraHighVolume =
     volume > avgVolume * 1.80

//------------------------------
// MOMENTUM ENGINE
//------------------------------

bullMomentum =
     close > open and
     close > high[1]

bearMomentum =
     close < open and
     close < low[1]

//------------------------------
// ATR EXPANSION
//------------------------------

atrAverage = ta.sma(atr, 20)

atrExpansion =
     atr > atrAverage

//------------------------------
// MOMENTUM SCORE
//------------------------------

bullMomentumScore = 0

bullMomentumScore += highVolume ? 30 : 0
bullMomentumScore += bullMomentum ? 35 : 0
bullMomentumScore += atrExpansion ? 35 : 0

bearMomentumScore = 0

bearMomentumScore += highVolume ? 30 : 0
bearMomentumScore += bearMomentum ? 35 : 0
bearMomentumScore += atrExpansion ? 35 : 0

//------------------------------
// FINAL MOMENTUM
//------------------------------

strongBullMomentum =
     bullMomentumScore >= 70

strongBearMomentum =
     bearMomentumScore >= 70

// Hidden Plot
//==================================================
// BUILD-08 : AI SCORE ENGINE
//==================================================

//------------------------------
// TREND SCORE
//------------------------------

int trendScore = 0

if trendBull
    trendScore += 25

if strongTrend
    trendScore += 25

//------------------------------
// STRUCTURE SCORE
//------------------------------

int bullStructureScore = bullishStructure ? 25 : 0
int bearStructureScore = bearishStructure ? 25 : 0

//------------------------------
// BUY SCORE
//------------------------------

buyScore = trendScore + bullStructureScore + smartBullScore + bullMomentumScore

if buyScore > 100
    buyScore := 100

//------------------------------
// SELL SCORE
//------------------------------

sellScore = trendScore + bearStructureScore + smartBearScore + bearMomentumScore

if sellScore > 100
    sellScore := 100

//------------------------------
// AI CONFIDENCE
//------------------------------

highConfidenceBuy = buyScore >= 85
highConfidenceSell = sellScore >= 85

// Hidden Plot
//==================================================
// BUILD-09A : CORE AI ENTRY FOUNDATION
//==================================================

// Timeframe
bool tf1m = timeframe.isminutes and timeframe.multiplier == 1
bool tf3m = timeframe.isminutes and timeframe.multiplier == 3
bool tf5m = timeframe.isminutes and timeframe.multiplier == 5

// AI Threshold
int aiThreshold =
     tf1m ? 80 :
     tf3m ? 78 :
     tf5m ? 75 : 75

// Trend
bool trendReadyBuy = trendBull and strongTrend
bool trendReadySell = trendBear and strongTrend

// Momentum
bool momentumReadyBuy = strongBullMomentum
bool momentumReadySell = strongBearMomentum

// Smart Money
bool smartReadyBuy = smartMoneyBull and institutionalBull
bool smartReadySell = smartMoneyBear and institutionalBear

// Structure
bool structureReadyBuy = bullishStructure
bool structureReadySell = bearishStructure

// AI Ready
bool aiBuyReady = buyScore >= aiThreshold
bool aiSellReady = sellScore >= aiThreshold

//==================================================
// BUILD-09B : AVERAGE CANDLE RANGE ENGINE
//==================================================

// Previous Day High / Low
float prevDayHigh = request.security(syminfo.tickerid, "D", high[1])
float prevDayLow  = request.security(syminfo.tickerid, "D", low[1])

// Previous Day Range
float prevDayRange = prevDayHigh - prevDayLow

// Candles Per Day
int candlesPerDay = tf1m ? 1440 : tf3m ? 480 : tf5m ? 288 : 288

// Average Candle Range (ACR)
float averageCandleRange = prevDayRange / candlesPerDay

// Current Candle Range
float currentCandleRange = high - low

// Expansion Ratio
float expansionRatio = currentCandleRange / averageCandleRange

// Expansion Levels
bool normalExpansion = expansionRatio >= 1.00
bool strongExpansion = expansionRatio >= 1.50
bool explosiveExpansion = expansionRatio >= 2.00

// Hidden Plot
//==================================================
// BUILD-09C : RANGE EXHAUSTION ENGINE
//==================================================

// Today's High / Low
float todayHigh = request.security(syminfo.tickerid, "D", high)
float todayLow  = request.security(syminfo.tickerid, "D", low)

// Current Day Range
float todayRange = todayHigh - todayLow

// Previous Day Range Ratio
float rangeUsed = prevDayRange > 0 ? todayRange / prevDayRange : 0.0

// Remaining Range
float remainingRange = math.max(prevDayRange - todayRange, 0)

// Range Status
bool earlyTrend = rangeUsed < 0.30
bool midTrend = rangeUsed >= 0.30 and rangeUsed < 0.70
bool lateTrend = rangeUsed >= 0.70 and rangeUsed < 0.90
bool exhaustedTrend = rangeUsed >= 0.90

// Estimated Remaining Move
float estimatedMove = remainingRange

// Trade Permission
bool allowFreshBuy = not exhaustedTrend
bool allowFreshSell = not exhaustedTrend

//==================================================
// BUILD-09D : AI ENTRY DECISION ENGINE
//==================================================

//------------------------------
// MASTER BUY READY
//------------------------------

bool masterBuyReady = trendReadyBuy and structureReadyBuy and smartReadyBuy and momentumReadyBuy and aiBuyReady and allowFreshBuy and strongExpansion

//------------------------------
// MASTER SELL READY
//------------------------------

bool masterSellReady = trendReadySell and structureReadySell and smartReadySell and momentumReadySell and aiSellReady and allowFreshSell and strongExpansion

//------------------------------
// SCALP BUY READY
//------------------------------

bool scalpBuyReady = trendBull and bullMomentum and normalExpansion and not exhaustedTrend

//------------------------------
// SCALP SELL READY
//------------------------------

bool scalpSellReady = trendBear and bearMomentum and normalExpansion and not exhaustedTrend

//==================================================
// BUILD-09E : FINAL SIGNAL ENGINE 
//==================================================

//------------------------------
// MASTER SIGNAL
//------------------------------

bool masterBuySignal = masterBuyReady and not masterBuyReady[1]

bool masterSellSignal = masterSellReady and not masterSellReady[1]

//------------------------------
// SCALP SIGNAL
//------------------------------

bool scalpBuySignal = scalpBuyReady and not scalpBuyReady[1] and not masterBuySignal

bool scalpSellSignal = scalpSellReady and not scalpSellReady[1] and not masterSellSignal

//------------------------------
// SAVE STATE
//------------------------------

if masterBuySignal
    tradeState := 1
    entryPrice := close

if masterSellSignal
    tradeState := -1
    entryPrice := close

//==================================================
// BUILD-10A : AI DECISION SCORE ENGINE
//==================================================

//------------------------------
// SCORE
//------------------------------

int aiDecisionBuy = 0
int aiDecisionSell = 0

// Trend
if trendReadyBuy
    aiDecisionBuy += 20

if trendReadySell
    aiDecisionSell += 20

// Structure
if structureReadyBuy
    aiDecisionBuy += 15

if structureReadySell
    aiDecisionSell += 15

// Smart Money
if smartReadyBuy
    aiDecisionBuy += 15

if smartReadySell
    aiDecisionSell += 15

// Momentum
if momentumReadyBuy
    aiDecisionBuy += 10

if momentumReadySell
    aiDecisionSell += 10

// Expansion
if strongExpansion
    aiDecisionBuy += 10
    aiDecisionSell += 10

// AI Score
if aiBuyReady
    aiDecisionBuy += 30

if aiSellReady
    aiDecisionSell += 30

//------------------------------
// FINAL GRADE
//------------------------------

bool gradeAPlusBuy = aiDecisionBuy >= 95
bool gradeABuy = aiDecisionBuy >= 85 and aiDecisionBuy < 95
bool gradeBBuy = aiDecisionBuy >= 75 and aiDecisionBuy < 85

bool gradeAPlusSell = aiDecisionSell >= 95
bool gradeASell = aiDecisionSell >= 85 and aiDecisionSell < 95
bool gradeBSell = aiDecisionSell >= 75 and aiDecisionSell < 85

//==================================================
// BUILD-10B : EXPECTED MOVE ENGINE
//==================================================

//------------------------------
// BASE MOVE
//------------------------------

float baseMove = averageCandleRange * 10.0

//------------------------------
// MULTIPLIER
//------------------------------

float moveMultiplier = 1.0

if gradeAPlusBuy or gradeAPlusSell
    moveMultiplier := 2.50
else if gradeABuy or gradeASell
    moveMultiplier := 2.00
else if gradeBBuy or gradeBSell
    moveMultiplier := 1.50

//------------------------------
// EXPECTED MOVE
//------------------------------

float minimumMove = baseMove * 0.50 * moveMultiplier
float expectedMove = baseMove * moveMultiplier
float maximumMove = baseMove * 2.00 * moveMultiplier

//------------------------------
// TREND STAGE
//------------------------------

string trendStage = "EARLY"

if midTrend
    trendStage := "MID"

if lateTrend
    trendStage := "LATE"

if exhaustedTrend
    trendStage := "EXHAUSTED"

//------------------------------
// MOVE QUALITY
//------------------------------

bool enoughMoveBuy = expectedMove >= minimumMove
bool enoughMoveSell = expectedMove >= minimumMove

//==================================================
// BUILD-10C : TREND HEALTH ENGINE
//==================================================

//------------------------------
// TREND HEALTH SCORE
//------------------------------

int trendHealth = 0

if trendBull
    trendHealth += 25

if strongTrend
    trendHealth += 25

if strongBullMomentum or strongBearMomentum
    trendHealth += 20

if strongExpansion
    trendHealth += 15

if not exhaustedTrend
    trendHealth += 15

if trendHealth > 100
    trendHealth := 100

//------------------------------
// REVERSAL RISK
//------------------------------

int reversalRisk = 0

if exhaustedTrend
    reversalRisk += 35

if not strongExpansion
    reversalRisk += 20

if trendStage == "LATE"
    reversalRisk += 20

if trendStage == "EXHAUSTED"
    reversalRisk += 25

if reversalRisk > 100
    reversalRisk := 100

//------------------------------
// TREND STATUS
//------------------------------

bool healthyTrend = trendHealth >= 75
bool warningTrend = trendHealth >= 50 and trendHealth < 75
bool weakTrend = trendHealth < 50

//==================================================
// BUILD-10D : TRADE DECISION ENGINE
//==================================================

//------------------------------
// TRADE CONTINUE
//------------------------------

bool continueBuy = tradeState == 1 and healthyTrend and reversalRisk < 50

bool continueSell = tradeState == -1 and healthyTrend and reversalRisk < 50

//------------------------------
// PARTIAL PROFIT
//------------------------------

bool partialProfitBuy = tradeState == 1 and warningTrend and reversalRisk >= 50

bool partialProfitSell = tradeState == -1 and warningTrend and reversalRisk >= 50

//------------------------------
// EXIT TRADE
//------------------------------

bool exitBuy = tradeState == 1 and weakTrend and reversalRisk >= 75

bool exitSell = tradeState == -1 and weakTrend and reversalRisk >= 75

//------------------------------
// SCALP OPPORTUNITY
//------------------------------

bool scalpSellOpportunity = continueBuy and bearMomentum and strongExpansion

bool scalpBuyOpportunity = continueSell and bullMomentum and strongExpansion

//------------------------------
// REVERSAL ALERT
//------------------------------

bool reversalAlert = reversalRisk >= 80

// Hidden Plot
//==================================================
// BUILD-11A : DYNAMIC TP ENGINE
//==================================================

//------------------------------
// ENTRY ATR
//------------------------------

float tradeATR = atr

//------------------------------
// BUY TARGETS
//------------------------------

float buyTP1 = entryPrice + (tradeATR * 1.50)
float buyTP2 = entryPrice + (tradeATR * 3.00)
float buyTP3 = entryPrice + (tradeATR * 5.00)

//------------------------------
// SELL TARGETS
//------------------------------

float sellTP1 = entryPrice - (tradeATR * 1.50)
float sellTP2 = entryPrice - (tradeATR * 3.00)
float sellTP3 = entryPrice - (tradeATR * 5.00)

//------------------------------
// TP HIT
//------------------------------

bool buyTP1Hit = tradeState == 1 and high >= buyTP1
bool buyTP2Hit = tradeState == 1 and high >= buyTP2
bool buyTP3Hit = tradeState == 1 and high >= buyTP3

bool sellTP1Hit = tradeState == -1 and low <= sellTP1
bool sellTP2Hit = tradeState == -1 and low <= sellTP2
bool sellTP3Hit = tradeState == -1 and low <= sellTP3

// Hidden Plot
//==================================================
// BUILD-11B : TRADE MANAGEMENT ENGINE
//==================================================

//------------------------------
// BUY TRADE PROGRESS
//------------------------------

float buyProgress = tradeState == 1 ? (high - entryPrice) : 0.0

//------------------------------
// SELL TRADE PROGRESS
//------------------------------

float sellProgress = tradeState == -1 ? (entryPrice - low) : 0.0

//------------------------------
// BREAK EVEN
//------------------------------

bool moveToBreakEvenBuy = tradeState == 1 and buyTP1Hit

bool moveToBreakEvenSell = tradeState == -1 and sellTP1Hit

//------------------------------
// TRAILING
//------------------------------

bool trailBuy = tradeState == 1 and buyTP2Hit

bool trailSell = tradeState == -1 and sellTP2Hit

//------------------------------
// RUNNER
//------------------------------

bool runnerBuy = tradeState == 1 and buyTP3Hit

bool runnerSell = tradeState == -1 and sellTP3Hit

//------------------------------
// TRADE ACTIVE
//------------------------------

bool tradeRunning = tradeState != 0

//==================================================
// BUILD-11C : HYBRID TP AI ENGINE
//==================================================

//------------------------------
// TP MULTIPLIER
//------------------------------

float tpMultiplier = 1.0

if gradeAPlusBuy or gradeAPlusSell
    tpMultiplier := 2.50
else if gradeABuy or gradeASell
    tpMultiplier := 2.00
else if gradeBBuy or gradeBSell
    tpMultiplier := 1.50

//------------------------------
// HYBRID BASE RANGE
//------------------------------

float hybridRange = (tradeATR + averageCandleRange) * tpMultiplier

//------------------------------
// DYNAMIC BUY TARGETS
//------------------------------

float aiBuyTP1 = entryPrice + hybridRange
float aiBuyTP2 = entryPrice + (hybridRange * 2.0)
float aiBuyTP3 = entryPrice + (hybridRange * 3.0)

//------------------------------
// DYNAMIC SELL TARGETS
//------------------------------

float aiSellTP1 = entryPrice - hybridRange
float aiSellTP2 = entryPrice - (hybridRange * 2.0)
float aiSellTP3 = entryPrice - (hybridRange * 3.0)

//------------------------------
// HYBRID TP HIT
//------------------------------

bool aiBuyTP1Hit = tradeState == 1 and high >= aiBuyTP1
bool aiBuyTP2Hit = tradeState == 1 and high >= aiBuyTP2
bool aiBuyTP3Hit = tradeState == 1 and high >= aiBuyTP3

bool aiSellTP1Hit = tradeState == -1 and low <= aiSellTP1
bool aiSellTP2Hit = tradeState == -1 and low <= aiSellTP2
bool aiSellTP3Hit = tradeState == -1 and low <= aiSellTP3

//==================================================
// BUILD-12A : AI REVERSAL PREDICTION ENGINE
//==================================================

//------------------------------
// REVERSAL SCORE
//------------------------------

int reversalScore = 0

if exhaustedTrend
    reversalScore += 25

if not strongExpansion
    reversalScore += 15

if trendStage == "LATE"
    reversalScore += 20

if trendStage == "EXHAUSTED"
    reversalScore += 20

if trendHealth < 60
    reversalScore += 20

if reversalScore > 100
    reversalScore := 100

//------------------------------
// REVERSAL LEVEL
//------------------------------

bool reversalWatch = reversalScore >= 50

bool reversalWarning = reversalScore >= 70

bool reversalConfirmed = reversalScore >= 90

//------------------------------
// ALERT
//------------------------------

alertcondition(reversalWatch, title="Reversal Watch", message="ATE : Reversal Watch")

alertcondition(reversalWarning, title="Reversal Warning", message="ATE : Reversal Warning")

alertcondition(reversalConfirmed, title="Confirmed Reversal", message="ATE : Confirmed Reversal")

//==================================================
// BUILD-12B : MARKET CYCLE AI ENGINE
//==================================================

//------------------------------
// MARKET CYCLE SCORE
//------------------------------

int marketCycleScore = 0

if trendBull
    marketCycleScore += 20

if strongTrend
    marketCycleScore += 20

if strongExpansion
    marketCycleScore += 20

if trendHealth >= 80
    marketCycleScore += 20

if reversalScore < 40
    marketCycleScore += 20

if marketCycleScore > 100
    marketCycleScore := 100

//------------------------------
// MARKET PHASE
//------------------------------

string marketPhase = "ACCUMULATION"

if marketCycleScore >= 25
    marketPhase := "EXPANSION"

if marketCycleScore >= 60
    marketPhase := "TREND"

if marketCycleScore >= 85
    marketPhase := "STRONG TREND"

if reversalConfirmed
    marketPhase := "REVERSAL"

//------------------------------
// ENTRY FILTER
//------------------------------

bool allowMasterTrade = marketPhase != "REVERSAL"

bool allowScalpTrade = marketPhase == "TREND" or marketPhase == "STRONG TREND"

//==================================================
// BUILD-12C : INSTITUTIONAL ENTRY FILTER
//==================================================

//------------------------------
// MASTER FILTER
//------------------------------

bool institutionalBuyReady = allowMasterTrade and masterBuyReady and healthyTrend and marketCycleScore >= 80 and reversalScore < 40 and enoughMoveBuy

bool institutionalSellReady = allowMasterTrade and masterSellReady and healthyTrend and marketCycleScore >= 80 and reversalScore < 40 and enoughMoveSell

//------------------------------
// SCALP FILTER
//------------------------------

bool institutionalScalpBuy = allowScalpTrade and scalpBuyReady and trendHealth >= 60 and reversalScore < 60

bool institutionalScalpSell = allowScalpTrade and scalpSellReady and trendHealth >= 60 and reversalScore < 60

//==================================================
// BUILD-13A : AI PROBABILITY ENGINE
//==================================================

// BUY Probability
int buyProbability = 0

buyProbability += trendReadyBuy ? 25 : 0
buyProbability += structureReadyBuy ? 20 : 0
buyProbability += smartReadyBuy ? 15 : 0
buyProbability += momentumReadyBuy ? 15 : 0
buyProbability += strongExpansion ? 10 : 0
buyProbability += healthyTrend ? 10 : 0
buyProbability += reversalScore < 40 ? 5 : 0

// SELL Probability
int sellProbability = 0

sellProbability += trendReadySell ? 25 : 0
sellProbability += structureReadySell ? 20 : 0
sellProbability += smartReadySell ? 15 : 0
sellProbability += momentumReadySell ? 15 : 0
sellProbability += strongExpansion ? 10 : 0
sellProbability += healthyTrend ? 10 : 0
sellProbability += reversalScore < 40 ? 5 : 0

// Final AI Approval
bool finalBuyApproved = buyProbability >= 75
bool finalSellApproved = sellProbability >= 75

//==================================================
// BUILD-13B : FINAL AI ENTRY FILTER
//==================================================

bool finalMasterBuy = masterBuySignal and institutionalBuyReady and finalBuyApproved and trendHealth >= 80 and reversalScore <= 30 and marketCycleScore >= 80

bool finalMasterSell = masterSellSignal and institutionalSellReady and finalSellApproved and trendHealth >= 80 and reversalScore <= 30 and marketCycleScore >= 80

//==================================================
// BUILD-14A : ENTRY QUALITY ENGINE
//==================================================

// Entry Quality Score
int entryQuality = 0

entryQuality += trendHealth >= 80 ? 20 : 0
entryQuality += marketCycleScore >= 80 ? 20 : 0
entryQuality += buyProbability >= 85 or sellProbability >= 85 ? 20 : 0
entryQuality += strongExpansion ? 15 : 0
entryQuality += reversalScore <= 30 ? 15 : 0
entryQuality += enoughMoveBuy or enoughMoveSell ? 10 : 0

// Entry Grades
bool gradeS = entryQuality >= 95
bool gradeA = entryQuality >= 75 and entryQuality < 95
bool gradeB = entryQuality >= 75 and entryQuality < 85

//==================================================
// BUILD-14B : SIGNAL COOLDOWN ENGINE
//==================================================

// Cooldown Bars
int signalCooldownBars =
     timeframe.multiplier <=1 ? 5 :
     timeframe.multiplier <=3 ? 4 :
     3

// Last Signal Bars
var int lastMasterBuyBar = na
var int lastMasterSellBar = na

// Cooldown Check
bool masterBuyCooldown = na(lastMasterBuyBar) or (bar_index - lastMasterBuyBar >= signalCooldownBars)
bool masterSellCooldown = na(lastMasterSellBar) or (bar_index - lastMasterSellBar >= signalCooldownBars)

// Final Signal
bool finalBuySignal = finalMasterBuy and gradeA and masterBuyCooldown
bool finalSellSignal = finalMasterSell and gradeA and masterSellCooldown

// Save Signal Bar
if finalBuySignal
    lastMasterBuyBar := bar_index

if finalSellSignal
    lastMasterSellBar := bar_index

//==================================================
// BUILD-15A : IMPULSE FILTER ENGINE (FIXED)
//==================================================

// Candle
float candleBody = math.abs(close - open)
float candleRange = high - low

// Strong Body
bool strongBody = candleRange > 0 ? candleBody / candleRange >= 0.60 : false

// Volume Expansion
bool volumeExpansion = volume > ta.sma(volume, 20) * 1.30

// ATR Expansion
bool impulseATR = candleRange > atr * 1.20

// Bullish Impulse
bool bullishImpulse =
     close > open and
     strongBody and
     volumeExpansion and
     impulseATR

// Bearish Impulse
bool bearishImpulse =
     close < open and
     strongBody and
     volumeExpansion and
     impulseATR

//==================================================
// BUILD-15B : HIGHER TIMEFRAME FILTER
//==================================================

// Higher Timeframe EMA
float htfFastEMA = request.security(syminfo.tickerid, "5", ta.ema(close, fastLength))
float htfSlowEMA = request.security(syminfo.tickerid, "5", ta.ema(close, slowLength))

// HTF Trend
bool htfBullTrend = htfFastEMA > htfSlowEMA
bool htfBearTrend = htfFastEMA < htfSlowEMA

// Final HTF Filter
bool htfBuyFilter = htfBullTrend
bool htfSellFilter = htfBearTrend

//==================================================
// BUILD-15C : RANGE PROJECTION ENGINE (FIXED)
