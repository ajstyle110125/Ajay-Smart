//@version=6
indicator("Smart AI Crypto Pro v4 Build1", shorttitle="SAICP v4 B1", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

//====================================================
// SECTION 01 - CORE ENGINE
//====================================================

// Version
const string VERSION = "v4.0-beta Build1"

//-------------------------
// INPUT GROUPS
//-------------------------

string grpGeneral   = "General"
string grpTrend     = "Trend Engine"

//-------------------------
// GENERAL SETTINGS
//-------------------------

showSignals = input.bool(true, "Show Buy/Sell Signals", group=grpGeneral)
showDebug   = input.bool(false, "Debug Mode", group=grpGeneral)

//-------------------------
// COLORS
//-------------------------

BUY_COLOR  = color.lime
SELL_COLOR = color.red

//-------------------------
// GLOBAL VARIABLES
//-------------------------

var bool tradeOpen = false
var int tradeSide = 0

var float entryPrice = na
var float stopLoss   = na

var float tp1 = na
var float tp2 = na
var float tp3 = na
var float tp4 = na
var float tp5 = na
var float tp6 = na
var float tp7 = na
var float tp8 = na

//====================================================
// SECTION 02 - TREND ENGINE
//====================================================

//-------------------------
// INPUTS
//-------------------------

fastEMA   = input.int(20, "Fast EMA", minval=1, group=grpTrend)
slowEMA   = input.int(50, "Slow EMA", minval=1, group=grpTrend)
trendEMA  = input.int(200, "Trend EMA", minval=1, group=grpTrend)
atrLength = input.int(14, "ATR Length", minval=1, group=grpTrend)

//-------------------------
// CALCULATIONS
//-------------------------

emaFast  = ta.ema(close, fastEMA)
emaSlow  = ta.ema(close, slowEMA)
emaTrend = ta.ema(close, trendEMA)

atr = ta.atr(atrLength)

//-------------------------
// TREND CONDITIONS
//-------------------------

bullTrend = emaFast > emaSlow and close > emaTrend
bearTrend = emaFast < emaSlow and close < emaTrend

bullCross = ta.crossover(emaFast, emaSlow)
bearCross = ta.crossunder(emaFast, emaSlow)

emaDistance = math.abs(emaFast - emaSlow)

strongBullTrend = bullTrend and emaDistance > atr * 0.30
strongBearTrend = bearTrend and emaDistance > atr * 0.30

//-------------------------
// HIDDEN PLOTS
//-------------------------

plot(emaFast, title="EMA Fast", display=display.none)
plot(emaSlow, title="EMA Slow", display=display.none)
plot(emaTrend, title="EMA Trend", display=display.none)

// Dummy plot (Build1 Compile Test)
plot(close, title="Build1 Test", display=display.none)

//====================================================
// SECTION 03 - MOMENTUM ENGINE
//====================================================

//-------------------------
// INPUTS
//-------------------------

string grpMomentum = "Momentum Engine"

rsiLength = input.int(14, "RSI Length", minval=2, group=grpMomentum)

macdFastLength = input.int(12, "MACD Fast", minval=1, group=grpMomentum)
macdSlowLength = input.int(26, "MACD Slow", minval=1, group=grpMomentum)
macdSignalLength = input.int(9, "MACD Signal", minval=1, group=grpMomentum)

volumeLength = input.int(20, "Volume MA", minval=1, group=grpMomentum)

//-------------------------
// RSI
//-------------------------

rsi = ta.rsi(close, rsiLength)

bullRSI = rsi > 55
bearRSI = rsi < 45

//-------------------------
// MACD
//-------------------------

[macdLine, signalLine, histLine] = ta.macd(close, macdFastLength, macdSlowLength, macdSignalLength)

bullMACD = macdLine > signalLine
bearMACD = macdLine < signalLine

//-------------------------
// VOLUME
//-------------------------

volumeMA = ta.sma(volume, volumeLength)

highVolume = volume > volumeMA

//-------------------------
// MOMENTUM SCORE
//-------------------------

int bullMomentumScore = 0
int bearMomentumScore = 0

if bullRSI
    bullMomentumScore += 25

if bullMACD
    bullMomentumScore += 25

if highVolume
    bullMomentumScore += 25

if strongBullTrend
    bullMomentumScore += 25

if bearRSI
    bearMomentumScore += 25

if bearMACD
    bearMomentumScore += 25

if highVolume
    bearMomentumScore += 25

if strongBearTrend
    bearMomentumScore += 25

//-------------------------
// FINAL MOMENTUM
//-------------------------

bullMomentum = bullMomentumScore >= 75
bearMomentum = bearMomentumScore >= 75

//-------------------------
// HIDDEN PLOTS
//-------------------------

plot(rsi, title="RSI", display=display.none)
plot(macdLine, title="MACD", display=display.none)
plot(signalLine, title="MACD Signal", display=display.none)
plot(histLine, title="MACD Histogram", display=display.none)

//====================================================
// SECTION 04 - AI SCORING ENGINE
//====================================================

//-------------------------
// INPUTS
//-------------------------

string grpAI = "AI Engine"

minimumAIScore = input.int(70, "Minimum AI Score", minval=50, maxval=100, group=grpAI)

//-------------------------
// AI SCORES
//-------------------------

int aiBuyScore = 0
int aiSellScore = 0

// Trend Score
if strongBullTrend
    aiBuyScore += 30

if strongBearTrend
    aiSellScore += 30

// Momentum Score
if bullMomentum
    aiBuyScore += 30

if bearMomentum
    aiSellScore += 30

// EMA Cross
if bullCross
    aiBuyScore += 20

if bearCross
    aiSellScore += 20

// Candle Confirmation
bullCandle = close > open
bearCandle = close < open

if bullCandle
    aiBuyScore += 20

if bearCandle
    aiSellScore += 20

//-------------------------
// AI SIGNALS
//-------------------------

buySignal = aiBuyScore >= minimumAIScore
sellSignal = aiSellScore >= minimumAIScore

//-------------------------
// AI RATING
//-------------------------

string aiRating = "NEUTRAL"

if buySignal
    aiRating := "BUY"
else if sellSignal
    aiRating := "SELL"

//-------------------------
// HIDDEN PLOTS
//-------------------------

plot(aiBuyScore, title="AI Buy Score", display=display.none)
plot(aiSellScore, title="AI Sell Score", display=display.none)
//====================================================
// SECTION 05 - SMART MONEY CONCEPTS (SMC)
//====================================================

//-------------------------
// INPUTS
//-------------------------

string grpSMC = "Smart Money"

swingLength = input.int(5, "Swing Length", minval=2, group=grpSMC)

//-------------------------
// SWING DETECTION
//-------------------------

swingHigh = ta.pivothigh(high, swingLength, swingLength)
swingLow  = ta.pivotlow(low, swingLength, swingLength)

var float lastSwingHigh = na
var float lastSwingLow  = na

if not na(swingHigh)
    lastSwingHigh := swingHigh

if not na(swingLow)
    lastSwingLow := swingLow

//-------------------------
// BREAK OF STRUCTURE
//-------------------------

bullBOS = not na(lastSwingHigh) and close > lastSwingHigh
bearBOS = not na(lastSwingLow) and close < lastSwingLow

//-------------------------
// CHANGE OF CHARACTER
//-------------------------

bullCHOCH = bullBOS and bearTrend
bearCHOCH = bearBOS and bullTrend

//-------------------------
// SMC SCORE
//-------------------------

int smcBuyScore = 0
int smcSellScore = 0

if bullBOS
    smcBuyScore += 40

if bullCHOCH
    smcBuyScore += 60

if bearBOS
    smcSellScore += 40

if bearCHOCH
    smcSellScore += 60

//-------------------------
// FINAL SMC SIGNAL
//-------------------------

bullSMC = smcBuyScore >= 60
bearSMC = smcSellScore >= 60

//-------------------------
// HIDDEN PLOTS
//-------------------------

plot(smcBuyScore, title="SMC Buy Score", display=display.none)
plot(smcSellScore, title="SMC Sell Score", display=display.none)
//====================================================
// SECTION 06 - UNIFIED SIGNAL ENGINE
//====================================================

//-------------------------
// INPUTS
//-------------------------

string grpSignal = "Signal Engine"

useTrendFilter = input.bool(true, "Use Trend Filter", group=grpSignal)
useMomentumFilter = input.bool(true, "Use Momentum Filter", group=grpSignal)
useSMCFilter = input.bool(true, "Use Smart Money Filter", group=grpSignal)

//-------------------------
// FILTER RESULTS
//-------------------------

trendBuyOK = not useTrendFilter or strongBullTrend
trendSellOK = not useTrendFilter or strongBearTrend

momentumBuyOK = not useMomentumFilter or bullMomentum
momentumSellOK = not useMomentumFilter or bearMomentum

smcBuyOK = not useSMCFilter or bullSMC
smcSellOK = not useSMCFilter or bearSMC

//-------------------------
// FINAL SIGNALS
//-------------------------

finalBuySignal =
     buySignal and
     trendBuyOK and
     momentumBuyOK and
     smcBuyOK

finalSellSignal =
     sellSignal and
     trendSellOK and
     momentumSellOK and
     smcSellOK

//-------------------------
// SIGNAL STRENGTH
//-------------------------

int signalStrength = 0

if finalBuySignal
    signalStrength := aiBuyScore + smcBuyScore

if finalSellSignal
    signalStrength := aiSellScore + smcSellScore

//-------------------------
// HIDDEN PLOTS
//-------------------------

plot(signalStrength, title="Signal Strength", display=display.none)
