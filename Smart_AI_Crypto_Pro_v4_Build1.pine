//@version=6
indicator("Smart AI Crypto Pro v4 Build1", shorttitle="SAICP v4 B1", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

//====================================================
// SECTION 01 - CORE ENGINE
//====================================================

// Version
const string VERSION = "v4.0-beta Build1"

//-------------------------
// INPUT GROUPS
//-------------------------

string grpGeneral   = "General"
string grpTrend     = "Trend Engine"

//-------------------------
// GENERAL SETTINGS
//-------------------------

showSignals = input.bool(true, "Show Buy/Sell Signals", group=grpGeneral)
showDebug   = input.bool(false, "Debug Mode", group=grpGeneral)

//-------------------------
// COLORS
//-------------------------

BUY_COLOR  = color.lime
SELL_COLOR = color.red

//-------------------------
// GLOBAL VARIABLES
//-------------------------

var bool tradeOpen = false
var int tradeSide = 0

var float entryPrice = na
var float stopLoss   = na

var float tp1 = na
var float tp2 = na
var float tp3 = na
var float tp4 = na
var float tp5 = na
var float tp6 = na
var float tp7 = na
var float tp8 = na

//====================================================
// SECTION 02 - TREND ENGINE
//====================================================

//-------------------------
// INPUTS
//-------------------------

fastEMA   = input.int(20, "Fast EMA", minval=1, group=grpTrend)
slowEMA   = input.int(50, "Slow EMA", minval=1, group=grpTrend)
trendEMA  = input.int(200, "Trend EMA", minval=1, group=grpTrend)
atrLength = input.int(14, "ATR Length", minval=1, group=grpTrend)

//-------------------------
// CALCULATIONS
//-------------------------

emaFast  = ta.ema(close, fastEMA)
emaSlow  = ta.ema(close, slowEMA)
emaTrend = ta.ema(close, trendEMA)

atr = ta.atr(atrLength)

//-------------------------
// TREND CONDITIONS
//-------------------------

bullTrend = emaFast > emaSlow and close > emaTrend
bearTrend = emaFast < emaSlow and close < emaTrend

bullCross = ta.crossover(emaFast, emaSlow)
bearCross = ta.crossunder(emaFast, emaSlow)

emaDistance = math.abs(emaFast - emaSlow)

strongBullTrend = bullTrend and emaDistance > atr * 0.30
strongBearTrend = bearTrend and emaDistance > atr * 0.30

//-------------------------
// HIDDEN PLOTS
//-------------------------

plot(emaFast, title="EMA Fast", display=display.none)
plot(emaSlow, title="EMA Slow", display=display.none)
plot(emaTrend, title="EMA Trend", display=display.none)

// Dummy plot (Build1 Compile Test)
plot(close, title="Build1 Test", display=display.none)

