//==================================================

// Active TP State
var int activeTP = 0

// Reset on New Trade
if finalBuy or finalSell
    activeTP := 1

//==============================
// BUY TP HIT
//==============================

if tradeState == 1

    if activeTP == 1 and high >= tp1
        activeTP := 2

    if activeTP == 2 and high >= tp2
