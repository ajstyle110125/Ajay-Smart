//@version=5
indicator("Trading Legend Range Levels", overlay=true)

// --- Inputs ---
divisor = input.float(2.09, "Range Divisor", minval=0.01, step=0.01, tooltip="The previous day's range is divided by this number.")
baselineSource = input.string("Daily Open", "Level Baseline", options=["Daily Open", "Prev Day Close"])

// --- Calculations ---
// Fetching data from the daily timeframe
prevHigh  = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
prevLow   = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)
dailyOpen = request.security(syminfo.tickerid, "D", open, lookahead=barmerge.lookahead_on)
prevClose = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)

// Determine the anchor price for the levels
anchorPrice = baselineSource == "Daily Open" ? dailyOpen : prevClose

// Formula: (High - Low) / Custom Divisor
distance = (prevHigh - prevLow) / divisor

// --- Plotting Logic ---
plotLevel(levelNum, isUp) =>
    price = isUp ? anchorPrice + (distance * levelNum) : anchorPrice - (distance * levelNum)
    price

// Colors
upColor   = color.new(color.teal, 20)
downColor = color.new(color.maroon, 20)

// Upward Levels
plot(plotLevel(1, true), "Upper 1", color=upColor, style=plot.style_linebr, linewidth=1)
plot(plotLevel(2, true), "Upper 2", color=upColor, style=plot.style_linebr, linewidth=1)
plot(plotLevel(3, true), "Upper 3", color=upColor, style=plot.style_linebr, linewidth=2)
plot(plotLevel(4, true), "Upper 4", color=upColor, style=plot.style_linebr, linewidth=1)
plot(plotLevel(5, true), "Upper 5", color=upColor, style=plot.style_linebr, linewidth=2)

// Downward Levels
plot(plotLevel(1, false), "Lower 1", color=downColor, style=plot.style_linebr, linewidth=1)
plot(plotLevel(2, false), "Lower 2", color=downColor, style=plot.style_linebr, linewidth=1)
plot(plotLevel(3, false), "Lower 3", color=downColor, style=plot.style_linebr, linewidth=2)
plot(plotLevel(4, false), "Lower 4", color=downColor, style=plot.style_linebr, linewidth=1)
plot(plotLevel(5, false), "Lower 5", color=downColor, style=plot.style_linebr, linewidth=2)

// Baseline Plot
plot(anchorPrice, "Baseline", color=color.gray, style=plot.style_circles, linewidth=2)
