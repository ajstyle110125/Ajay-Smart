//==============================
// VERSION
//==============================

string VERSION = "v5.0 Build-01"

//==============================
// INPUT GROUPS
//==============================

string grpSignal = "Signal Engine"
string grpTrade  = "Trade Engine"
string grpRisk   = "Risk Management"
string grpVisual = "Chart Display"

//==============================
// USER INPUTS
//==============================

bool showBuySell = input.bool(true, "Show Buy / Sell", group=grpVisual)
bool showTradeZone = input.bool(true, "Show Long / Short Zone", group=grpVisual)
bool showTargets = input.bool(true, "Show TP Levels", group=grpVisual)

float riskReward = input.float(2.0, "Risk Reward", minval=1.0, step=0.5, group=grpRisk)

//==============================
// COLORS
//==============================

color BUY_COLOR   = color.lime
color SELL_COLOR  = color.red
color LONG_COLOR  = color.new(color.green, 85)
color SHORT_COLOR = color.new(color.red, 85)
color TP_COLOR    = color.green
color SL_COLOR    = color.red

//==============================
// TRADE STATE
//==============================

// 0 = No Trade
// 1 = Buy Active
// -1 = Sell Active

var int tradeState = 0

var float entryPrice = na
var float stopLoss   = na

var float tp1 = na
var float tp2 = na
var float tp3 = na
var float tp4 = na
var float tp5 = na
var float tp6 = na

//==============================
// DRAWING OBJECTS
//==============================


var line slLine  = na
var line tp1Line = na
var line tp2Line = na
var line tp3Line = na
var line tp4Line = na
var line tp5Line = na
var line tp6Line = na

//==================================================
// MARKET STRUCTURE ENGINE
// BUILD-02
//==================================================

// Swing Length
int swingLength = 5

// Detect Swing High / Low
float swingHigh = ta.pivothigh(high, swingLength, swingLength)
float swingLow  = ta.pivotlow(low, swingLength, swingLength)

// Store latest confirmed swings
var float lastSwingHigh = na
var float lastSwingLow  = na

if not na(swingHigh)
    lastSwingHigh := swingHigh

if not na(swingLow)
    lastSwingLow := swingLow

// Trend State
var bool bullishStructure = false
var bool bearishStructure = false

bullishStructure := not na(lastSwingHigh) and close > lastSwingHigh
bearishStructure := not na(lastSwingLow) and close < lastSwingLow  

//==================================================
// TREND ENGINE
// BUILD-03
//==================================================

// EMA Trend
fastEMA = ta.ema(close, 20)
slowEMA = ta.ema(close, 50)

// Trend Direction
bool upTrend = fastEMA > slowEMA and bullishStructure
bool downTrend = fastEMA < slowEMA and bearishStructure

// Trend Strength
bool strongBull = upTrend and close > fastEMA
bool strongBear = downTrend and close < fastEMA

//==================================================
// BUILD-04 : SIGNAL ENGINE
//==================================================

//==================================================
// SIGNAL TRIGGERS
//==================================================

bool longReady  = ta.crossover(fastEMA, slowEMA) or (strongBull and close > high[1])
bool shortReady = ta.crossunder(fastEMA, slowEMA) or (strongBear and close < low[1])

// Signal State
bool buySignal  = longReady and tradeState != 1
bool sellSignal = shortReady and tradeState != -1

// BUY
if buySignal
    tradeState := 1
    entryPrice := close

// SELL
if sellSignal
    tradeState := -1
    entryPrice := close

// BUY LABEL
plotshape(
     series = showBuySell and buySignal,
     title = "BUY",
     style = shape.labelup,
     location = location.belowbar,
     color = BUY_COLOR,
     text = "BUY",
     textcolor = color.black,
     size = size.small)

// SELL LABEL
plotshape(
     series = showBuySell and sellSignal,
     title = "SELL",
     style = shape.labeldown,
     location = location.abovebar,
     color = SELL_COLOR,
     text = "SELL",
     textcolor = color.white,
     size = size.small)

